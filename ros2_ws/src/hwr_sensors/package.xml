<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hwr_sensors</name>
  <version>0.0.1</version>
  <description>Sensor bring-up under our stack: lidar launch (wraps the
  sclidar_ros2 binary, ADR-006) and our scan band-pass filter.</description>
  <maintainer email="adam9x6loeb@googlemail.com">Niko</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
