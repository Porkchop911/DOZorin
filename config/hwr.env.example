# Copy to config/hwr.env on the robot and replace with a random >=24-char value.
# Never commit the real token.
HWR_GATEWAY_TOKEN=replace-with-a-long-random-token
HWR_MAP_YAML=/home/ubuntu/hwr/maps/hwr_map_01.yaml
# Ears (hwr-ears.service): Hermes API server on the PC via relay :12341, and the session it joins.
HWR_HERMES_URL=http://192.168.0.148:12341
HWR_HERMES_KEY=replace-with-API_SERVER_KEY-from-the-robot-profile
HWR_HERMES_SESSION=replace-with-hermes-session-id
